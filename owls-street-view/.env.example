# Alpaca API Credentials (Paper Trading by default)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_MODE=paper

# Financial Modeling Prep API Key (Optional, for stock screener fundamentals)
FMP_API_KEY=your_fmp_api_key_here

# Dashboard Authentication Password (Optional)
DASHBOARD_PASSWORD=your_secure_password_here

# SSO Authentication (Google and Temple University)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=
ALLOWED_EMAILS=

TEMPLE_CLIENT_ID=mock
TEMPLE_CLIENT_SECRET=
TEMPLE_REDIRECT_URI=
TEMPLE_AUTH_URL=https://fim.temple.edu/idp/profile/oidc/authorize
TEMPLE_TOKEN_URL=https://fim.temple.edu/idp/profile/oidc/token
TEMPLE_USERINFO_URL=https://fim.temple.edu/idp/profile/oidc/userinfo

