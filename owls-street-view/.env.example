# Alpaca API Credentials (Paper Trading by default)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_MODE=paper

# Financial Modeling Prep API Key (Optional, for stock screener fundamentals)
FMP_API_KEY=your_fmp_api_key_here

# Dashboard Authentication Password (Optional)
DASHBOARD_PASSWORD=your_secure_password_here

# URL of the running owls-street-pulse instance (Owl Speaks chat proxy)
PULSE_URL=http://localhost:8000

# Session signing key. Leave unset only for local development: the code falls back
# to a hardcoded default, which would let anyone forge a session.
SSO_JWT_SECRET=

# SSO Authentication — Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must exactly match the console entry, e.g. http://localhost:8080/api/auth/google/callback
GOOGLE_REDIRECT_URI=
ALLOWED_EMAILS=

# SSO Authentication — Microsoft Entra (Temple University's tenant)
MICROSOFT_CLIENT_ID=mock
MICROSOFT_CLIENT_SECRET=
# Must exactly match the console entry, e.g. http://localhost:8080/api/auth/microsoft/callback
MICROSOFT_REDIRECT_URI=
MICROSOFT_ALLOWED_EMAILS=

