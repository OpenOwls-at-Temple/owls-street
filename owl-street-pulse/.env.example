# Alpaca Credentials
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_API_SECRET=your_alpaca_api_secret

# Alert Destination Webhooks (Optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-100123456789

# Database Configuration (Optional, defaults to data/alerts.db)
DATABASE_PATH=data/alerts.db

# Dashboard Authentication Password (Optional)
DASHBOARD_PASSWORD=your_secure_password_here

# SSO Authentication (Google and Temple University)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=
ALLOWED_EMAILS=

TEMPLE_CLIENT_ID=mock
TEMPLE_CLIENT_SECRET=
TEMPLE_REDIRECT_URI=
TEMPLE_AUTH_URL=https://fim.temple.edu/idp/profile/oidc/authorize
TEMPLE_TOKEN_URL=https://fim.temple.edu/idp/profile/oidc/token
TEMPLE_USERINFO_URL=https://fim.temple.edu/idp/profile/oidc/userinfo

