# Alpaca Credentials
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_API_SECRET=your_alpaca_api_secret

# Alert Destination Webhooks (Optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-100123456789

# Database Configuration (Optional, defaults to data/alerts.db)
DATABASE_PATH=data/alerts.db

# Dashboard Authentication Password (Optional)
DASHBOARD_PASSWORD=your_secure_password_here

# Owl Speaks Chat Agent (Optional, requires a reachable Ollama instance).
#
# Three ways to point it somewhere, in order of precedence:
#
#   1. OLLAMA_BASE_URL — any Ollama-compatible endpoint. The loopback default below is
#      right for a local machine and for Docker on the same host.
#   2. OLLAMA_API_KEY — Ollama Cloud. Set this and leave OLLAMA_BASE_URL unset, and
#      requests go to https://ollama.com with a bearer token. This is the simplest way to
#      get chat working on a serverless deployment, which has no loopback interface and so
#      cannot reach the default below. Create a key at https://ollama.com/settings/keys.
#   3. Neither — the loopback default.
#
# OLLAMA_MODEL follows the endpoint when unset: llama3.1 locally, mistral-large-3:675b on the
# cloud, whose catalogue is a different one (see https://ollama.com/search).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_API_KEY=

# Local development only. Enables a mock sign-in that issues a session for any email
# without contacting Google/Microsoft. Leave unset everywhere else — setting it in a
# deployment is an authentication bypass.
ALLOW_MOCK_SSO=

# Session signing key. Leave unset only for local development: the code falls back
# to a hardcoded default, which would let anyone forge a session.
SSO_JWT_SECRET=

# SSO Authentication — Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must exactly match the console entry, e.g. http://localhost:8000/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Only for the combined Vercel deployment, where one environment serves both apps and this
# app's callback lives under /pulse. Overrides GOOGLE_REDIRECT_URI for Pulse alone, e.g.
# https://your-domain.vercel.app/pulse/api/auth/google/callback
PULSE_GOOGLE_REDIRECT_URI=
ALLOWED_EMAILS=

