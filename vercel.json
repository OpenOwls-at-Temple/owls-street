{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "owls-street-view/frontend",
      "outputDirectory": "build"
    },
    "view": {
      "root": "owls-street-view",
      "framework": "fastapi",
      "entrypoint": "api.index:app"
    },
    "pulse": {
      "root": "owls-street-pulse",
      "framework": "fastapi",
      "entrypoint": "api.index:app"
    }
  },
  "rewrites": [
    { "source": "/pulse", "destination": { "service": "pulse" } },
    { "source": "/pulse/(.*)", "destination": { "service": "pulse" } },
    { "source": "/api/(.*)", "destination": { "service": "view" } },
    { "source": "/auth/(.*)", "destination": { "service": "view" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
