# Secrets for the combined Vercel deployment.
#
#   cp .env.vercel.example .env.vercel     # .env.vercel is gitignored
#   # fill in the values below
#   ./scripts/vercel-env-push.sh
#
# Leave anything you don't use blank — blank values are skipped, not pushed as empty.
# One Vercel project serves both apps from one environment, which is why a few values are
# duplicated under the two names each app reads.


# ── Required: market data ──────────────────────────────────────────────────────
# From https://app.alpaca.markets — paper credentials are fine to start.
# The key is one value under one name; the secret needs both names, because the view reads
# ALPACA_SECRET_KEY and Pulse reads ALPACA_API_SECRET.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_API_SECRET=

# "paper" or "live". Keep this on paper until you have deliberately decided otherwise:
# with "live", the dashboard's order panel places real orders.
ALPACA_MODE=paper


# ── Required: locking the dashboard ────────────────────────────────────────────
# Without this the deployment is open to anyone with the URL. It is also how the view
# authenticates its chat proxy to Pulse, so both apps need the same value — which one
# project's shared environment gives you for free.
#
# SSO_JWT_SECRET is already set to a generated value. Leave it blank here unless you want
# to rotate it; setting it will invalidate every existing session.
DASHBOARD_PASSWORD=
SSO_JWT_SECRET=


# ── Owl Speaks chat ────────────────────────────────────────────────────────────
# An Ollama Cloud key from https://ollama.com/settings/keys. A serverless function has no
# loopback interface, so this is what makes chat work on Vercel.
OLLAMA_API_KEY=

# Optional. Defaults to mistral-large-3:675b when a key is set — chosen because it can read
# the chart screenshots the chat accepts, which most cloud models reject. Names are a different
# catalogue from a local install's — see https://ollama.com/search.
OLLAMA_MODEL=


# ── Optional: screener fundamentals ────────────────────────────────────────────
# From https://site.financialmodelingprep.com — without it the screener still returns
# Alpaca snapshots, just no fundamental ratios.
FMP_API_KEY=


# ── Optional: Google sign-in ───────────────────────────────────────────────────
# Register BOTH redirect URIs in the Google Cloud console. The two apps' callbacks sit at
# different paths, and one project means one environment, so they need separate variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://owls-street-all.vercel.app/api/auth/google/callback
PULSE_GOOGLE_REDIRECT_URI=https://owls-street-all.vercel.app/pulse/api/auth/google/callback

# Comma-separated allowlist. Leave blank to allow any Google account that signs in.
ALLOWED_EMAILS=


# ── Optional: Microsoft sign-in (the view only) ────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://owls-street-all.vercel.app/api/auth/microsoft/callback
MICROSOFT_ALLOWED_EMAILS=


# ── Not needed here ────────────────────────────────────────────────────────────
# The alert engine runs as a GitHub Actions job, not on Vercel, so notifier credentials
# belong in the repository's Actions secrets instead:
#   DISCORD_WEBHOOK_URL, SLACK_WEBHOOK_URL, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
#
# PULSE_URL and PULSE_PATH_PREFIX are already set and are not secrets.
